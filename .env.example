# Copy this file to .env.local and fill in the Supabase and WhatsApp credentials.
# Set NEXT_PUBLIC_APP_URL to the origin serving this app in each environment.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_API_URL=https://graph.facebook.com/v21.0
