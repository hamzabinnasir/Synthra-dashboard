# Copy this file to .env.local. These Supabase values must point to the same
# project as backend/.env so WhatsApp, Facebook, and Instagram share inbox data.
# Set NEXT_PUBLIC_APP_URL to the origin serving this app in each environment.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_API_URL=https://graph.facebook.com/v21.0
FACEBOOK_SUPABASE_URL=
FACEBOOK_SUPABASE_SERVICE_ROLE_KEY=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_VERSION=v21.0
# Instagram Login access token; server-only, do not use a NEXT_PUBLIC_ prefix.
IG_ACCESS_TOKEN=
INSTAGRAM_GRAPH_VERSION=v25.0
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ADMIN_JWT_SECRET=

# Required for 'Forgot password' emails (e.g. Gmail: smtp.gmail.com, port 587, an App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
